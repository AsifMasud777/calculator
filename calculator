    private void jButton_eqActionPerformed(java.awt.event.ActionEvent evt) {                                           
      num2=Double.parseDouble(jTextField_dis.getText());
      switch(oparetor){
          case "+": 
              res=num1 + num2;
              ans=String.format("%.0f", res);
              jTextField_dis.setText(ans);
              break;
           case "-": 
              res=num1 - num2;
              ans=String.format("%.0f", res);
              jTextField_dis.setText(ans);
              break;
            case "*": 
              res=num1 * num2;
              ans=String.format("%.0f", res);
              jTextField_dis.setText(ans);
              break;  
             case "/": 
              res=num1 / num2;
              ans=String.format("%.0f", res);
              jTextField_dis.setText(ans);
              break;  
              
      }
    }                                          

